# Required.
ATRIA_API_KEY=atr_your_key_here
ATRIA_BASE_URL=https://api.atria-asi.ai/v1
ATRIA_MODEL=Atria-Dawn-Preview

# Optional knobs. Everything below has a sensible default and can also be set
# on the command line (--max-iterations, --timeout, --temperature).
# ATRIA_MAX_ITERATIONS=25
# ATRIA_TIMEOUT=120
# ATRIA_TEMPERATURE=0.2
